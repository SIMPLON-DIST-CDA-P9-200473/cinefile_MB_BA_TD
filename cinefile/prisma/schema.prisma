generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id      Int      @id @default(autoincrement())
  nom     String   @unique
  membres Membre[]
}

model Membre {
  id               Int      @id @default(autoincrement())
  pseudo           String   @unique
  nom              String
  prenom           String
  email            String   @unique
  motDePasse       String

  avatar           String?
  dateInscription  DateTime @default(now())
  biographie       String?

  roleId           Int
  role             Role @relation(fields: [roleId], references: [id])
}

model Film {
  idFilm          Int       @id @default(autoincrement())
  idTmdbFilm      Int       @unique
  titreFilm       String
  dateSortieFilm  DateTime
  resumeFilm      String
  bandeAnnonceFilm String?
  afficheFilm     String

  avis            Avis[]
}

model Genre {
  idGenre   Int    @id @default(autoincrement())
  nomGenre  String @unique
}

model Plateforme {
  idPlateforme      Int    @id @default(autoincrement())
  idTmdbPlateforme  Int    @unique
  nomPlateforme     String @unique
  logoPlateforme    String
}