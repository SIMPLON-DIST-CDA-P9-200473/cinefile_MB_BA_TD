generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Role {
  id      Int      @id @default(autoincrement())
  nom     String   @unique
  membres Membre[]
}

model Membre {
  id        Int    @id @default(autoincrement())
  pseudo    String @unique
  nom       String
  prenom    String
  email     String @unique
  motDePasse String

  avatar           String?
  dateInscription  DateTime @default(now())
  biographie       String?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])
}